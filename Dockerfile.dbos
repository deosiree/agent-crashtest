# Experiment 005 on Linux: the dbos_crash runner plus the pydantic-ai + DBOS
# subject in its own environment, as on the host. Run through docker-compose.yml:
#   CRASHTEST_GIT_COMMIT=$(git rev-parse HEAD) docker compose --profile experiments run --rm dbos-crash
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# The subject's environment, from the same lock file as on the host.
COPY subjects/requirements/pydantic_ai_dbos_refund_agent.txt /tmp/subject.txt
RUN python -m venv /subject && /subject/bin/pip install --no-cache-dir -r /tmp/subject.txt

# The harness. PYTHONPATH puts /app/src first so the runner finds /app/subjects.
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY subjects ./subjects
ENV PYTHONPATH=/app/src

RUN useradd --create-home appuser && mkdir /out && chown appuser /out
USER appuser

ENTRYPOINT ["python", "-m", "crashtest.experiment.dbos_crash", "--python", "/subject/bin/python", \
            "--sink-url", "http://sink:8101", \
            "--system-database", "postgresql+psycopg://crashtest:crashtest@postgres:5432/crashtest", \
            "--out-dir", "/out"]
